{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  // Nix lock maintenance refreshes host nixpkgs and sops-nix. The tagged Pi
  // platform and its nested inputs stay at the versions in nvmd's lock file.
  schedule: ["every weekend"],
  automerge: false,
  nix: { enabled: true },
  lockFileMaintenance: {
    enabled: true,
    schedule: ["every weekend"],
  },
  packageRules: [{
    // Native extraction confuses root nixpkgs with nvmd's nested node.
    // Maintenance runs Nix directly; disable individual input/channel bumps.
    matchManagers: ["nix"],
    matchUpdateTypes: ["!lockFileMaintenance"],
    enabled: false,
  }],
}
